{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Motorcycle Shop API Gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Idempotency-Key"]
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/login",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": [
            "http://auth_service:8000"
          ],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/inventory",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/items",
          "encoding": "json",
          "sd": "static",
          "method": "GET",
          "host": [
            "http://inventory_service:8000"
          ],
          "disable_host_sanitize": false
        }
      ]
    },
    {
      "endpoint": "/api/v1/sales/checkout",
      "method": "POST",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 20,
          "client_capacity": 20,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/checkout",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": [
            "http://sales_service:8000"
          ],
          "disable_host_sanitize": false
        }
      ]
    }
  ]
}
