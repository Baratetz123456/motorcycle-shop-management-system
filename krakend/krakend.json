      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type", "Idempotency-Key"],
      "backend": [
        {
          "url_pattern": "/transactions/{id}/void",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://sales_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/repairs/motorcycle-models",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/motorcycle-models",
          "encoding": "no-op",
