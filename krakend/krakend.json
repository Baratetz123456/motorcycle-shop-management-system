{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Motorcycle Shop API Gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "input_headers": ["Authorization", "Content-Type", "Idempotency-Key", "X-Forwarded-For", "Accept"],
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Idempotency-Key"]
    },
    "router": {
      "return_error_details": "always"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Content-Type"],
      "backend": [
        {
          "url_pattern": "/login",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/logout",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/logout",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/change-password",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "url_pattern": "/change-password",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/users/register",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "url_pattern": "/users/register",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/users",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/users",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/users/{id}",
      "method": "PUT",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "url_pattern": "/users/{id}",
          "encoding": "json",
          "sd": "static",
          "method": "PUT",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/users/{id}",
      "method": "DELETE",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/users/{id}",
          "encoding": "json",
          "sd": "static",
          "method": "DELETE",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/audit-logs",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/audit-logs",
