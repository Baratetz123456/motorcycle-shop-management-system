{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Motorcycle Shop API Gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "input_headers": ["Authorization", "Content-Type", "Idempotency-Key", "X-Forwarded-For", "Accept"],
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Idempotency-Key"]
    },
    "router": {
      "return_error_details": "always"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Content-Type"],
      "backend": [
        {
          "url_pattern": "/login",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/logout",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/logout",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/audit-logs",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/audit-logs",
          "encoding": "json",
          "sd": "static",
          "method": "GET",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/audit-logs/export",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/audit-logs/export",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": ["http://auth_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/inventory",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/items",
          "encoding": "json",
          "sd": "static",
          "method": "GET",
          "host": ["http://inventory_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/sales/checkout",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type", "Idempotency-Key"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 20,
          "client_capacity": 20,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/checkout",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://sales_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/repairs/jobs",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/jobs",
          "encoding": "json",
          "sd": "static",
          "method": "GET",
          "host": ["http://repairs_service:8000"]
        }
      ]
    }
  ]
}
