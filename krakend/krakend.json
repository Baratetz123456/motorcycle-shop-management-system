      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/items",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": ["http://inventory_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/inventory",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type", "Idempotency-Key"],
      "backend": [
        {
          "url_pattern": "/items",
          "encoding": "json",
          "sd": "static",
          "method": "POST",
          "host": ["http://inventory_service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/inventory/{id}",
      "method": "PUT",
      "output_encoding": "json",
